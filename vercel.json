{
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/sync?mode=tables",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/sync?mode=scorers",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/live?mode=leagues",
      "schedule": "30 1 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "claude/*": false
    }
  },
  "functions": {
    "api/live.js": {
      "maxDuration": 60
    }
  }
}
