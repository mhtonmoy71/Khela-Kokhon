{
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/sync?mode=tables",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/sync?mode=scorers",
      "schedule": "0 4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "claude/*": false
    }
  }
}
