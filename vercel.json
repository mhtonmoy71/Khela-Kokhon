{
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/sync?mode=tables",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/sync?mode=scorers",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/live?mode=leagues",
      "schedule": "30 1 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/page?sitemap=1"
    },
    {
      "source": "/faq",
      "destination": "/api/page?p=faq"
    },
    {
      "source": "/match/:id",
      "destination": "/api/page?m=:id"
    },
    {
      "source": "/league/:code",
      "destination": "/api/page?l=:code"
    },
    {
      "source": "/bangladesh",
      "destination": "/api/page?l=BAN"
    },
    {
      "source": "/team/:id",
      "destination": "/api/page?t=:id"
    },
    {
      "source": "/((?!api/|\\.well-known/).*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "claude/*": false
    }
  },
  "functions": {
    "api/live.js": {
      "maxDuration": 60
    },
    "api/admin.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ]
}
